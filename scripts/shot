#!/usr/bin/env python3
"""Run a command in a throwaway Rex session, press keys, and save its screen as HTML.

  scripts/shot --out /tmp/rtm.html [--cols 150 --rows 42] [--keys "ctrl+n ctrl+n"] [--wait 1.5] -- rtm pick

Open the HTML with a screenshot tool to look at the TUI. The session is always killed.
Colours follow Seth's Rex theme (megaforest) and the xterm 256-colour cube.
"""
import argparse
import html
import json
import os
import subprocess
import sys
import time

THEME = {
    "background": "#272b30",
    "foreground": "#d8caac",
    "palette": ["#505a60", "#e67e80", "#a7c080", "#d9bb80", "#7fbbb3", "#d39bb6", "#7eb48b", "#ffffff",
                "#5c6370", "#E06C75", "#A7CF9B", "#e5c07b", "#7FBBD0", "#FCC5E9", "#78BA91", "#ffffff"],
}


def palette():
    colours = list(THEME["palette"])
    steps = [0, 95, 135, 175, 215, 255]
    for r in steps:
        for g in steps:
            for b in steps:
                colours.append(f"#{r:02x}{g:02x}{b:02x}")
    for i in range(24):
        v = 8 + i * 10
        colours.append(f"#{v:02x}{v:02x}{v:02x}")
    return colours


def rex(*args, check=True):
    return subprocess.run(["rex", "--autostart=false", *args], capture_output=True, text=True, check=check).stdout


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--out", required=True)
    parser.add_argument("--cols", type=int, default=150)
    parser.add_argument("--rows", type=int, default=42)
    parser.add_argument("--keys", default="")
    parser.add_argument("--wait", type=float, default=1.5)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        sys.exit("give a command after --")
    created = json.loads(rex("new", f"rtm-shot-{os.getpid()}", "--json", "--", *command))
    session = created["session_id"]
    block = created["initial_windows"][0]["block_ids"][0]
    try:
        # A size applies at once only for the block's owner, and every rex call is a new client:
        # claim and resize in one script.
        rex("do", "-s", session, "-e",
            f"rex.call('session.own_block', {{session_id='{session}', block_ids={{'{block}'}}}}); "
            f"return rex.call('block.method', {{session_id='{session}', block_id='{block}', method='resize', "
            f"args={{columns={args.cols}, rows={args.rows}}}}})")
        time.sleep(args.wait)
        for key in args.keys.split():
            if key.startswith("text:"):
                rex("send", "-s", session, "-b", block, key[5:])
            else:
                rex("send-key", "-s", session, "-b", block, key)
            time.sleep(0.15)
        time.sleep(args.wait if args.keys else 0)
        body = rex("capture", "-s", session, "-b", block, "--format", "html")
    finally:
        rex("kill", session, check=False)
    variables = "".join(f"--vt-palette-{i}:{c};" for i, c in enumerate(palette()))
    page = (f"<!doctype html><meta charset=utf-8><title>{html.escape(' '.join(command))}</title>"
            f"<style>:root{{{variables}}}body{{margin:0;padding:16px;background:{THEME['background']};"
            f"color:{THEME['foreground']};font:14px/1.3 'JetBrainsMono Nerd Font','SF Mono',Menlo,monospace}}"
            f"body>div{{font-family:inherit!important}}</style>{body}")
    with open(args.out, "w") as f:
        f.write(page)
    print(args.out)


if __name__ == "__main__":
    main()
